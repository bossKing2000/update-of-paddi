  commission   Float // platform's cut
  amount       Float // net amount actually paid to the vendor
  orderCount   Int

  periodStart DateTime
  periodEnd   DateTime

  status        PayoutStatus @default(PENDING)
  reference     String?      @unique // Paystack transfer reference, once initiated
  paidAt        DateTime?
  failureReason String?

  processedByAdminId String?
  processedByAdmin   User?   @relation("PayoutProcessedBy", fields: [processedByAdminId], references: [id])

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
}

model RefundRequest {
  id                String       @id @default(uuid())
  user              User         @relation(fields: [userId], references: [id])
  userId            String
  paymentRef        String // Paystack reference
  reason            String
  status            RefundStatus @default(PENDING)
  adminNote         String?
  resolvedByAdminId String?
  resolvedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Set when the admin submits the refund to Paystack (APPROVED -> PROCESSING).
  // Paystack's own refund id/reference — used to match the async
  // refund.processed / refund.failed webhook back to this request,
  // since Paystack can be refunding one of several partial requests
  // against the same paymentRef.
  paystackRefundId    String?
  // The amount (kobo) actually submitted to Paystack for this request;
  // null means a full refund of whatever remained on the payment.
  requestedAmountKobo Int?

  // Phase 3.2a: optional link to the single order this request refunds.
  // Nullable with no backfill — historical and batch-level (multi-order
  // payment) rows intentionally remain NULL. Deleting an order never
  // deletes refund history (RESTRICT); use deactivation/cancellation flows.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([paystackRefundId])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  // Paystack has accepted the refund request and is processing it —
  // money has not moved to the customer yet. Set after the POST /refund
  // call succeeds; only refund.processed webhook promotes to COMPLETED.
  PROCESSING
  COMPLETED
  // Paystack could not complete the refund (refund.failed webhook) —
  // the reserved amount is released back onto the payment so it can be
  // retried or a different amount refunded.
  FAILED
}

