generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  username    String?  @unique
  name        String
  email       String   @unique
  phoneNumber String?
  password    String?
  avatarUrl   String?
  preferences String[]
  bio         String?
  role        Role?
  brandName   String?
  brandLogo   String?
  googleId    String?  @unique

  // KYC (NIN verification via Dojah) — required for VENDOR and DELIVERY
  // before they can go live. See src/services/dojah.service.ts.
  kycStatus KycStatus @default(PENDING)
  nin       String?   @unique
  ninData   Json? // raw Dojah verification response, stored for audit/dispute purposes

  order_openAT        String?
  order_closeAT       String?
  // Vendor self-service settings persisted as JSON so the API can evolve without another table.
  operatingHours      Json?
  deliveryPreferences Json?
  serviceAreas        Json?

  // ── Vendor Live (marketplace migration) ──────────────────────
  // VENDOR only: whether this vendor is currently operating on the
  // marketplace. This is the vendor-level counterpart of the per-product
  // schedule mirror below — a product is marketplace-available only while
  // its vendor is live AND accepting orders AND the product itself is
  // available/unarchived within its own schedule. Customers cannot toggle
  // this; vendors flip it via PATCH /api/vendor/settings/live (KYC VERIFIED
  // required to go live). Default false for new vendors; existing vendors
  // were backfilled to true by the migration so pre-migration behavior is
  // preserved until each vendor explicitly goes offline.
  isLive Boolean @default(false)

  // IANA timezone for the vendor's business (e.g. "Africa/Lagos"). Used to
  // evaluate recurring product schedules in the vendor's local time.
  // Effective timezone = timezone ?? operatingHours.timezone ?? UTC.
  timezone String?

  // ── Vendor payout fields ──────────────────────────────────────
  // Didn't exist at all before — there was no way for a vendor to ever
  // receive a payout through the platform. commissionRate is per-vendor
  // so it can be negotiated individually rather than being a single
  // global constant.
  commissionRate        Float    @default(0.15)
  bankName              String?
  bankCode              String? // Paystack bank code, required for transfers (distinct from the display name)
  bankAccountNumber     String?
  bankAccountName       String? // set from Paystack's own resolution, not typed in by the vendor
  paystackRecipientCode String? // set once bank details are verified with Paystack; cleared whenever bank details change
  vendorPayouts         VendorPayout[] @relation("VendorPayouts")
  payoutsProcessed      VendorPayout[] @relation("PayoutProcessedBy")
  vendorPromotions      Promotion[]      @relation("VendorPromotions")
  promotionUsages       PromotionUsage[] @relation("UserPromotionUsages")
  vendorSupportTickets  VendorSupportTicket[] @relation("VendorSupportTickets")
  customerSupportTickets CustomerSupportTicket[] @relation("CustomerSupportTickets")

  // ── Referrals ──────────────────────────────────────────────────
  // Didn't exist at all before. Every user gets their own shareable
  // code (generated on first request rather than at signup, so
  // existing accounts get one lazily too); referredByUserId records
  // who they signed up through, if anyone.
  referralCode     String?  @unique
  referredByUserId String?
  referredBy       User?    @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referredUsers    User[]   @relation("UserReferrals")
  referralRewardsEarned  ReferralReward[] @relation("ReferralAsReferrer")
  referralRewardAsInvitee ReferralReward[] @relation("ReferralAsReferred")

  // Relations
  products              Product[]           @relation("VendorProducts")
  vendorReviewsReceived VendorReview[]      @relation("VendorReviews")
  vendorReviewsGiven    VendorReview[]      @relation("CustomerVendorReviews")
  productReviewsGiven   ProductReview[]     @relation("CustomerProductReviews")
  customerOrders        Order[]             @relation("CustomerOrders")
  vendorOrders          Order[]             @relation("VendorOrders")
  vendorRepliesSent     VendorReply[]       @relation("VendorReplies")
  reviewVotes           ReviewVote[]        @relation("UserReviewVotes")
  reviewReports         ReviewReport[]      @relation("UserReviewReports")
  notifications         Notification[]      @relation("UserNotifications")
  loginHistory          LoginHistory[]      @relation("UserLoginHistory")
  addresses             Address[]           @relation("UserAddresses")
  carts                 Cart[]              @relation("UserCarts")
  cartSummarySnapshots  CartSummarySnapshot[] @relation("UserCartSnapshots")
  UserPaymentMethod     UserPaymentMethod[]
  deliveryPerson        DeliveryPerson?
  riderWithdrawalsProcessed RiderWithdrawal[] @relation("RiderWithdrawalProcessedBy")
  deliveryProofsReviewed    DeliveryProof[]   @relation("DeliveryProofReviewedBy")

  tokenVersion               Int                 @default(0)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  authProviders              String[]
  lastLoginAt                DateTime?
  loginMethod                String?
  isEmailVerified            Boolean             @default(false)
  // Admin moderation — didn't exist at all before; no way to suspend an
  // account for fraud/abuse without deleting it outright.
  isBlocked                  Boolean             @default(false)
  blockedReason              String?
  blockedAt                  DateTime?
  emailVerificationToken     String?
  emailVerificationExpiresAt DateTime?
  passwordResetToken         PasswordResetToken? @relation("UserPasswordResetToken")
  payments                   Payment[]           @relation("UserPayments")
  RefundRequest              RefundRequest[]

  // ✅ Fixed Activity relations
  vendorActivities   Activity[] @relation("ActivityVendor")
  customerActivities Activity[] @relation("ActivityCustomer")

  // ✅ Vendor followers
  followers VendorFollower[] @relation("VendorFollowers") // people following this vendor
  following VendorFollower[] @relation("CustomerFollowing") // vendors this customer follows

  // Special Requests made by this user (as a customer)
  specialRequestsMade SpecialOrderRequest[] @relation("CustomerSpecialRequests")

  // Special Requests received by this user (as a vendor)
  specialRequestsReceived SpecialOrderRequest[] @relation("VendorSpecialRequests")

  // Special Offers sent by this vendor
  specialOffersSent SpecialOrderOffer[] @relation("VendorSpecialOffers")

  // Persistent refresh sessions — DB is source of truth, Redis is cache
  sessions UserSession[]
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  sessionId String   @unique
  ip        String?
  userAgent String?
  deviceId  String?
  geoCity   String?
  geoRegion String?
  geoCountry String?
  createdAt DateTime @default(now())
  lastRefreshedAt DateTime @updatedAt
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([userId, sessionId])
}

// 

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  street    String
  city      String
  state     String?
  country   String
  zipCode   String?
  landmark  String? // e.g. "Near Zenith Bank"
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([latitude, longitude])
  @@index([isDefault])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  archived    Boolean  @default(false) // just like a delete function
  category    Category

  images              String[]
  thumbnail           String?   // 👈 ADD THIS
  video               String[]
  vendorId            String
  vendor              User                  @relation(name: "VendorProducts", fields: [vendorId], references: [id], onDelete: Cascade)
  reviews             ProductReview[]       @relation("ProductReviews")
  orders              Order[]               @relation("ProductOrders")
  orderItems          OrderItem[]
  options             ProductOption[]       @relation("ProductOptions")
  averageRating       Float?                @default(0)
  reviewCount         Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  CartItem            CartItem[]
  totalViews          Int                   @default(0) // all-time total views
  popularityScore     Float                 @default(0)
  popularityUpdatedAt DateTime? // <-- add this line
  popularityPercent   Float                 @default(0) // ✅ new field
  isNew               Boolean               @default(false) // ✅ Make sure this is here
  // Special requests associated with this product
  specialRequests     SpecialOrderRequest[] @relation("ProductSpecialRequests")


  // 🟢 Live scheduling (mirrored for performance)
  isLive    Boolean   @default(false) // current live state
  liveUntil DateTime? // takeDownAt mirror

  // 🔗 Full schedule relation
  productSchedule ProductSchedule?

  // Essential indexes (keep these)
  @@index([name], map: "product_name_idx") // Speeds up search suggestions
  @@index([category], map: "product_category_idx") // Faster category filtering
  @@index([vendorId], map: "product_vendor_idx") // Helps with vendor-specific queries
  @@index([archived])
  @@index([createdAt])
  @@index([price])
  @@index([isLive])
}

model ProductSchedule {
  id        String  @id @default(uuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])

  // ONE_TIME = absolute goLiveAt/takeDownAt window (legacy/compat).
  // WEEKLY  = recurring weekly windows in ProductScheduleWindow, evaluated
  // against the vendor's effective timezone. The schedule definition is
  // the authoritative source; Product.isLive remains a display mirror.
  type    ProductScheduleType @default(ONE_TIME)
  enabled Boolean             @default(true)

  goLiveAt   DateTime?
  takeDownAt DateTime?
  isLive     Boolean   @default(false)

  // 🧭 Grace control for this session (ONE_TIME domain)
  graceMinutes       Int?    @default(0)
  autoGraceEnabled   Boolean @default(false)
  manualGraceEnabled Boolean @default(false)

  // WEEKLY recurrence range (optional). Interpreted as dates in the
  // vendor's effective timezone; inclusive on both ends.
  startDate DateTime?
  endDate   DateTime?

  windows ProductScheduleWindow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One availability window inside a WEEKLY ProductSchedule. Multiple rows
// per day are allowed (e.g. lunch 12:00–15:00 + dinner 18:00–22:00).
// endMinute <= startMinute means the window crosses midnight into the next
// day (e.g. Friday 22:00–02:00 → active Sat 00:00–02:00 as well).
model ProductScheduleWindow {
  id          String          @id @default(uuid())
  scheduleId  String
  schedule    ProductSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek   Int             // 0 = Sunday … 6 = Saturday (JS/Postgres dow)
  startMinute Int             // minutes from local midnight (0–1439)
  endMinute   Int             // minutes from local midnight (1–1440); <= start ⇒ overnight
  enabled     Boolean         @default(true)

  @@index([scheduleId, dayOfWeek])
}

enum ProductScheduleType {
  ONE_TIME
  WEEKLY
}

model ProductOption {
  id              String            @id @default(uuid())
  productId       String
  name            String
  price           Float
  product         Product           @relation("ProductOptions", fields: [productId], references: [id], onDelete: Cascade)
  OrderItemOption OrderItemOption[]
  CartItemOption  CartItemOption[]
}

model Order {
  id               String      @id @default(uuid())
  customerId       String
  vendorId         String
  addressId        String?
  basePrice        Float
  extraCharge      Float       @default(0)
  // Delivery fee for this specific order, computed once per vendor at
  // checkout (see cartSummary.service.ts / deliveryFee.service.ts).
  // Previously there was no delivery fee concept anywhere — deliveries
  // were effectively always free and there was no out-of-range check.
  deliveryFee      Float       @default(0)
  totalPrice       Float
  vendorNote       String?
  customerApproval Boolean     @default(false)
  status           OrderStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt // ✅ add default

  // Set from the checkout request's Idempotency-Key header. A single
  // checkout can produce multiple orders (one per vendor in the cart),
  // all sharing the same key — so this is indexed, not unique, and a
  // retry with the same key returns the existing order(s) instead of
  // creating duplicates.
  idempotencyKey String?

  // Set once this order's revenue has been included in a VendorPayout —
  // prevents the same completed order from being paid out to the vendor
  // twice across multiple payout runs.
  payoutId String?
  payout   VendorPayout? @relation(fields: [payoutId], references: [id])

  // Set when this order was created from an accepted special-order offer
  // rather than a normal cart checkout.
  specialOrderOfferId String?           @unique
  specialOrderOffer   SpecialOrderOffer? @relation("SpecialOfferOrder", fields: [specialOrderOfferId], references: [id])

  customer    User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  vendor      User                 @relation("VendorOrders", fields: [vendorId], references: [id], onDelete: Cascade)
  address     Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    Payment[]            @relation("OrderPayments")
  Product     Product[]            @relation("ProductOrders")
  assignments DeliveryAssignment[]
  earnings    DeliveryEarning[]

  paymentInitiatedAt DateTime? // you already had this; kept for compatibility
  paymentStartedAt   DateTime? // optional clearer alias if you want to set it explicitly

  // paymentExpiresAt   DateTime? // Track payment expiration time
  paidAt        DateTime? // ✅ add this
  paymentStatus PaymentStatus? @default(PENDING)

  cancelledAt         DateTime?
  cancellationReason  String? // "PAYMENT_EXPIRED" | "USER_CANCELLED" | "VENDOR_REJECTED"
  protectedUntil      DateTime? // ← new field
  paymentGraceMinutes Int?                @default(15)
  Activity            Activity[]
  DeliveryBroadcast   DeliveryBroadcast[]
  // @@index([paymentExpiresAt])

  @@index([customerId, createdAt])
  @@index([vendorId, createdAt])
  @@index([status])
  @@index([idempotencyKey])
  @@index([payoutId])
}

model OrderItem {
  id        String            @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  subtotal  Float
  createdAt DateTime          @default(now())
  updatedAt DateTime?  // specialRequest String? // NEW FIELD
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  options   OrderItemOption[]
}

model OrderItemOption {
  id            String        @id @default(uuid())
  optionId      String
  name          String
  price         Float
  orderItemId   String
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productOption ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([optionId])
}

model ProductReview {
  id               String   @id @default(uuid())
  productId        String
  customerId       String
  rating           Int
  comment          String?
  images           String[]
  createdAt        DateTime @default(now())
  verifiedPurchase Boolean  @default(false)

  product  Product        @relation("ProductReviews", fields: [productId], references: [id], onDelete: Cascade)
  customer User           @relation("CustomerProductReviews", fields: [customerId], references: [id], onDelete: Cascade)
  reply    VendorReply?
  votes    ReviewVote[]
  reports  ReviewReport[]

  @@index([productId, createdAt])
  @@index([customerId])
}

model VendorReply {
  id        String   @id @default(uuid())
  reviewId  String   @unique
  vendorId  String
  message   String
  createdAt DateTime @default(now())

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  vendor User          @relation("VendorReplies", fields: [vendorId], references: [id], onDelete: Cascade)
}

model ReviewVote {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  isHelpful Boolean
  createdAt DateTime @default(now())

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User          @relation("UserReviewVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

enum ReviewReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model ReviewReport {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  reason    String
  status    ReviewReportStatus @default(PENDING)
  resolvedByAdminId String?
  resolvedAt        DateTime?
  createdAt DateTime @default(now())

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User          @relation("UserReviewReports", fields: [userId], references: [id], onDelete: Cascade)
}

model VendorReview {
  id         String   @id @default(uuid())
  vendorId   String
  customerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  vendor   User @relation("VendorReviews", fields: [vendorId], references: [id], onDelete: Cascade)
  customer User @relation("CustomerVendorReviews", fields: [customerId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id         String   @id @default(uuid())
  userId     String
  method     String
  deviceId   String? // optional fingerprint
  location   String? // e.g. "Lagos, Nigeria"
  ip         String?
  userAgent  String?
  geoCity    String? // <-- add
  geoRegion  String? // <-- add
  geoCountry String? // <-- add
  createdAt  DateTime @default(now())

  user User @relation("UserLoginHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PasswordResetToken {
  userId    String   @id
  token     String
  expiresAt DateTime

  user User @relation("UserPasswordResetToken", fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  orderId      String // the primary/first order this payment was initiated for
  amount       Int //mount in kobo, e.g. 600000 = ₦6,000.00 ✅
  reference    String   @unique
  status       PaymentStatus @default(PENDING)
  paystackData Json? // ✅ Add this
  channel      String? // ✅ Optional
  ipAddress    String   @default("unknown") // ✅ fraud logs
  userAgent    String   @default("unknown") // ✅ fraud logs
  deviceId     String? // optional
  geoCity      String? // <-- add this
  geoCountry   String? // <-- add this
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt // ✅ add default
  metadata     Json? // ✅ add this line

  // A single checkout can produce multiple orders (one per vendor) that
  // are paid for together in one Paystack transaction. All orders in that
  // batch share this key (mirrors Order.idempotencyKey) — the finalizer
  // looks up every order with a matching key rather than assuming exactly
  // one order per payment.
  idempotencyKey String?

  // Self-healing lock so the finalizer (webhook, confirmPayment,
  // chargeSavedCard, and the verifyPendingPayments job can all reach the
  // same payment concurrently) only has one active finalization at a
  // time. A lock older than 2 minutes is treated as abandoned (crashed
  // process) and reclaimed rather than blocking forever.
  isProcessing        Boolean   @default(false)
  processingStartedAt DateTime?

  user  User  @relation("UserPayments", fields: [userId], references: [id])
  order Order @relation("OrderPayments", fields: [orderId], references: [id])

  // More explicit payment timestamps to support cleanup/cron logic
  startedAt   DateTime? // when payment was initiated (same moment you create Payment record)
  completedAt DateTime? // when the gateway/webhook confirmed success
  expiresAt   DateTime? // kobo amount must be paid before this time

  Receipt Receipt[]

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([idempotencyKey])
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
  DELIVERY
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SpecialOrderRequestStatus {
  PENDING
  OFFER_MADE
  ACCEPTED
  REJECTED
  CANCELLED
}

enum SpecialOrderOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Category {
  BREAKFAST
  LUNCH
  DINNER
  DESSERT
  DRINK
}

enum OrderStatus {
  PENDING // customer placed order
  WAITING_VENDOR_CONFIRMATION
  WAITING_CUSTOMER_APPROVAL
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  COOKING
  READY_FOR_PICKUP // optional if you want vendor to mark ready
  OUT_FOR_DELIVERY // order handed over to driver
  COMPLETED // customer received (final)
  CANCELLED // cancelled before/after payment
  FAILED_DELIVERY // if you want to track failed attempts
  PAYMENT_EXPIRED
  CANCELLED_UNPAID
}

// Used for both Order.paymentStatus and (as of this pass) Payment.status —
// previously Payment.status was a raw String and different code paths
// wrote inconsistent casing ('SUCCESS' vs "success"), which meant a
// refund-eligibility check or fulfillment check could silently fail
// depending on which code path had confirmed a given payment. One enum,
// shared, eliminates that entire class of bug.
enum DiscountType {
  PERCENTAGE
  FIXED
  DELIVERY
}

enum ReferralRewardStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  INITIATED // user clicked "Pay Now", payment flow started
  SUCCESS
  FAILED
  EXPIRED
  LATE_PAYMENT // payment arrived after the order's protection/grace window
  AMOUNT_MISMATCH // amount paid didn't match the order total
  REFUNDED
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  ipAddress  String
  userAgent  String
  deviceId   String?
  geoCity    String? // <-- add
  geoRegion  String? // <-- add
  geoCountry String? // <-- add
  details    Json?
  path       String
  metadata   Json?
  createdAt  DateTime @default(now())
}

// A settlement run for one vendor over a period — the actual mechanism by
// which money moves from the platform to a vendor's bank account.
// Previously there was no such model at all; "payout" was just numbers
// computed on the fly with no record of what had actually been paid.
// A discount code. vendorId set = scoped to that one vendor's items only
// (and only counts against that vendor's subtotal/delivery fee in a
// multi-vendor cart); vendorId null = platform-wide, applies across the
// whole cart. Deliberately simpler than product/category-level targeting
// — a vendor-or-platform-wide code covers the common "10% off" /
// "free delivery" cases without the added complexity of per-product
// promo rules, which can be added later if there's real demand for it.
model Promotion {
  id       String  @id @default(uuid())
  code     String
  vendorId String?
  vendor   User?   @relation("VendorPromotions", fields: [vendorId], references: [id], onDelete: Cascade)

  name        String
  description String?

  type        DiscountType
  value       Float // percentage (0-100) or fixed naira amount, depending on type
  maxDiscount Float? // caps a PERCENTAGE discount's naira value

  isActive Boolean @default(true)

  startsAt  DateTime?
  expiresAt DateTime?

  usageLimit     Int? // total redemptions allowed, across all users
  usedCount      Int  @default(0)
  maxUsesPerUser Int  @default(1)

  minOrderAmount Float @default(0) // minimum subtotal (of the scoped vendor, or whole cart if platform-wide) to qualify

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages PromotionUsage[]

  @@unique([vendorId, code])
  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
}

model PromotionUsage {
  id          String  @id @default(uuid())
  promotionId String
  userId      String
  orderIds    String[] // every order this redemption's discount was applied across (a multi-vendor checkout batch)
  promoCode   String
  discount    Float

  createdAt DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user      User      @relation("UserPromotionUsages", fields: [userId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([userId])
  @@index([userId, promotionId])
}

model ReferralReward {
  id         String @id @default(uuid())
  referrerId String
  referredId String

  orderId String? // the referred user's qualifying (first completed) order
  amount  Float   @default(0)

  status ReferralRewardStatus @default(PENDING)

  createdAt DateTime @default(now())

  referrer User @relation("ReferralAsReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralAsReferred", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
}

model VendorPayout {
  id       String @id @default(uuid())
  vendorId String
  vendor   User   @relation("VendorPayouts", fields: [vendorId], references: [id])

  grossRevenue Float // total order revenue included in this payout
  commission   Float // platform's cut
  amount       Float // net amount actually paid to the vendor
  orderCount   Int

  periodStart DateTime
  periodEnd   DateTime

  status        PayoutStatus @default(PENDING)
  reference     String?      @unique // Paystack transfer reference, once initiated
  paidAt        DateTime?
  failureReason String?

  processedByAdminId String?
  processedByAdmin   User?   @relation("PayoutProcessedBy", fields: [processedByAdminId], references: [id])

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
}

model RefundRequest {
  id         String       @id @default(uuid())
  user       User         @relation(fields: [userId], references: [id])
  userId     String
  paymentRef String // Paystack reference
  reason     String
  status     RefundStatus @default(PENDING)
  adminNote          String?
  resolvedByAdminId  String?
  resolvedAt         DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Cart {
  id         String   @id @default(uuid())
  customerId String
  basePrice  Float    @default(0)
  totalPrice Float    @default(0)
  // Held true for the duration of an in-flight checkout so a second
  // concurrent checkout request (double-tap, retry) can't race the first
  // one and create duplicate orders from the same cart.
  isLocked   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  customer User       @relation("UserCarts", fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  // Ensure all items are from same vendor
  @@index([customerId])
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  unitPrice Float
  subtotal  Float

  cart           Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  specialRequest String? // ✅ keep the note for this product
  options        CartItemOption[]
}

model CartItemOption {
  id              String @id @default(uuid())
  cartItemId      String
  productOptionId String
  name            String
  price           Float

  // Relations
  cartItem      CartItem      @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  productOption ProductOption @relation(fields: [productOptionId], references: [id], onDelete: Cascade)

  @@index([cartItemId])
  @@index([productOptionId])
}

// A point-in-time snapshot of what GET /cart/summary showed the customer
// (per-vendor subtotals, delivery fees, discount, final total). Checkout
// references a snapshot by id and re-validates the live cart against it —
// if anything's changed (price, delivery range, etc.) checkout is
// rejected with a clear "refresh your cart" error instead of silently
// charging a different amount than what was shown.
model CartSummarySnapshot {
  id        String   @id @default(uuid())
  userId    String
  snapshot  Json
  createdAt DateTime @default(now())

  user User @relation("UserCartSnapshots", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserPaymentMethod {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  cardToken String   @unique
  last4     String
  brand     String // visa, mastercard, etc
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryPerson {
  id              String               @id @default(uuid())
  userId          String               @unique
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType     String?
  licensePlate    String?
  status          DeliveryPersonStatus @default(ACTIVE)
  rating          Float                @default(0)
  totalDeliveries Int                  @default(0)
  isOnline        Boolean              @default(false)
  latitude        Float?
  longitude       Float?
  lastSeenAt      DateTime?
  assignedOrders  DeliveryAssignment[]
  earnings        DeliveryEarning[]
  walletBalance   Float                @default(0)
  payoutAccount   RiderPayoutAccount?
  withdrawals     RiderWithdrawal[]
  vehicle         RiderVehicle?
  supportTickets  RiderSupportTicket[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  DriverLocationLog DriverLocationLog[]

  Activity Activity[]

  @@index([userId])
}

model DeliveryAssignment {
  id               String         @id @default(uuid())
  orderId          String
  deliveryPersonId String
  status           DeliveryStatus @default(ASSIGNED)
  assignedAt       DateTime       @default(now())
  acceptedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  declinedAt       DateTime?
  timeoutSeconds   Int            @default(30)
  attempts         Int            @default(0)
  batchId          String? // For grouping multiple orders

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPerson DeliveryPerson @relation(fields: [deliveryPersonId], references: [id], onDelete: Cascade)
  proof          DeliveryProof?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deliveryPersonId])
  @@index([orderId])
}

model DeliveryEarning {
  id               String   @id @default(uuid())
  deliveryPersonId String
  orderId          String
  baseFee          Float
  distanceFee      Float
  tip              Float    @default(0)
  deductions       Float    @default(0)
  totalEarned      Float
  createdAt        DateTime @default(now())

  deliveryPerson DeliveryPerson @relation(fields: [deliveryPersonId], references: [id])
  order          Order          @relation(fields: [orderId], references: [id])
}

enum RiderWithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum RiderVehicleStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DeliveryProofStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

enum RiderSupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model RiderPayoutAccount {
  id               String   @id @default(uuid())
  deliveryPersonId String   @unique
  bankName         String
  bankCode         String
  accountNumber    String
  accountName      String
  recipientCode    String?
  verifiedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deliveryPerson DeliveryPerson @relation(fields: [deliveryPersonId], references: [id], onDelete: Cascade)
  withdrawals    RiderWithdrawal[]

  @@index([bankCode])
}

model RiderWithdrawal {
  id                 String                @id @default(uuid())
  deliveryPersonId   String
  payoutAccountId    String
  amount             Float
  balanceSnapshot    Float
  status             RiderWithdrawalStatus @default(PENDING)
  idempotencyKey     String
  reference          String?               @unique
  failureReason      String?
  requestedAt        DateTime              @default(now())
  processedAt        DateTime?
  processedByAdminId String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  deliveryPerson   DeliveryPerson      @relation(fields: [deliveryPersonId], references: [id], onDelete: Cascade)
  payoutAccount    RiderPayoutAccount @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)
  processedByAdmin User?              @relation("RiderWithdrawalProcessedBy", fields: [processedByAdminId], references: [id])

  @@unique([deliveryPersonId, idempotencyKey])
  @@index([deliveryPersonId, status])
  @@index([status, requestedAt])
}

model DeliveryProof {
  id                 String              @id @default(uuid())
  assignmentId       String              @unique
  proofUrl           String
  mediaType          String
  recipientName      String?
  note               String?
  status             DeliveryProofStatus @default(SUBMITTED)
  reviewNote         String?
  submittedAt        DateTime            @default(now())
  reviewedAt         DateTime?
  reviewedByAdminId  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  assignment      DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewedByAdmin User?              @relation("DeliveryProofReviewedBy", fields: [reviewedByAdminId], references: [id])

  @@index([status, submittedAt])
}

model RiderVehicle {
  id               String             @id @default(uuid())
  deliveryPersonId String             @unique
  vehicleType      String
  licensePlate     String             @unique
  make             String?
  model            String?
  color            String?
  documentUrl      String?
  status           RiderVehicleStatus @default(PENDING)
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  deliveryPerson DeliveryPerson @relation(fields: [deliveryPersonId], references: [id], onDelete: Cascade)

  @@index([status])
}

model RiderSupportTicket {
  id               String                   @id @default(uuid())
  deliveryPersonId String
  category         String
  subject          String
  description      String
  status           RiderSupportTicketStatus @default(OPEN)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  deliveryPerson DeliveryPerson @relation(fields: [deliveryPersonId], references: [id], onDelete: Cascade)

  @@index([deliveryPersonId, createdAt])
  @@index([deliveryPersonId, status])
}

enum DeliveryPersonStatus {
  ACTIVE // can receive assignments
  SUSPENDED // blocked by admin (fraud, complaints, etc.)
  INACTIVE // deactivated / self-paused
}

enum DeliveryBroadcastStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum DeliveryStatus {
  ASSIGNED // system auto-assigned to a driver
  ACCEPTED // driver accepted
  DECLINED // driver declined
  PICKED_UP // driver has collected order from vendor
  EN_ROUTE // on the way to customer
  DELIVERED // successfully delivered to customer
  FAILED // driver couldn’t deliver
  RETURNED // item returned to vendor
  CANCELLED // cancelled by system/vendor/customer
}

model DriverLocationLog {
  id        String   @id @default(cuid())
  driverId  String
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())

  driver DeliveryPerson @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

enum ActivityType {
  ORDER_CREATED
  PAYMENT_SUCCESS
  NEW_PAID_ORDER
  REFUND_REQUESTED
  REFUND_ISSUED
  REVIEW_POSTED
  DELIVERY_ASSIGNED
  DELIVERY_COMPLETED
  ORDER_EXPIRED
  ORDER_CANCELLED
  GENERAL
}

model Activity {
  id String @id @default(uuid())

  // Optional relationships
  orderId    String?
  vendorId   String?
  customerId String?
  deliveryId String?

  // Core fields
  type      ActivityType
  title     String
  message   String
  meta      Json?
  createdAt DateTime     @default(now())

  // ✅ Relations
  order    Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor   User?           @relation("ActivityVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  customer User?           @relation("ActivityCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  delivery DeliveryPerson? @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([vendorId])
  @@index([customerId])
  @@index([type])
}

enum BroadcastStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model DeliveryBroadcast {
  id               String   @id @default(cuid())
  orderId          String
  driverIds        String[] // Array of driver UUIDs
  declinedDriverIds String[] @default([]) // riders who explicitly dismissed this offer
  acceptedDriverId String?
  status           DeliveryBroadcastStatus // "PENDING" | "ACCEPTED" | "EXPIRED"
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  reference   String
  event       String
  payload     Json
  status      String    @default("pending") // pending, processing, done, failed
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@unique([reference, event])
}

model Receipt {
  id        String   @id @default(cuid())
  payment   Payment  @relation(fields: [paymentId], references: [id])
  paymentId String
  pdfUrl    String? // optional, if generating PDF
  createdAt DateTime @default(now())
}

model VendorFollower {
  id         String   @id @default(uuid())
  vendorId   String
  customerId String
  createdAt  DateTime @default(now())

  vendor   User @relation("VendorFollowers", fields: [vendorId], references: [id], onDelete: Cascade)
  customer User @relation("CustomerFollowing", fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([vendorId, customerId])
  @@index([vendorId])
  @@index([customerId])
}

model SpecialOrderRequest {
  id         String   @id @default(uuid())
  customerId String
  vendorId   String?       // optional, because request may exist before a vendor responds
  productId  String
  quantity   Int
  message    String        // you can use this as "details"
  status     SpecialOrderRequestStatus @default(PENDING)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer User    @relation("CustomerSpecialRequests", fields: [customerId], references: [id], onDelete: Cascade)
  vendor   User?   @relation("VendorSpecialRequests", fields: [vendorId], references: [id], onDelete: Cascade)
  product  Product @relation("ProductSpecialRequests", fields: [productId], references: [id], onDelete: Cascade)

  offers SpecialOrderOffer[]
}


model SpecialOrderOffer {
  id        String   @id @default(uuid())
  requestId String
  vendorId  String
  price     Float
  message   String?
  status    SpecialOrderOfferStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request SpecialOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor  User                @relation("VendorSpecialOffers", fields: [vendorId], references: [id], onDelete: Cascade)
  // Set once this offer is accepted and turned into a real order — lets
  // support/admin trace an order back to the special-offer negotiation
  // that produced it.
  order   Order?              @relation("SpecialOfferOrder")
}

enum RequestStatus {
  PENDING // waiting for vendor offers
  OFFER_MADE // vendor has made at least one offer
  ACCEPTED // customer accepted an offer
  REJECTED // customer rejected all offers
  CANCELLED // customer cancelled request
}

enum OfferStatus {
  PENDING // vendor submitted, customer has not responded
  ACCEPTED // customer accepted this offer
  REJECTED // customer rejected
  EXPIRED // offer timed out
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model VendorSupportTicket {
  id          String              @id @default(uuid())
  vendorId    String
  category    String
  subject     String
  description String
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  vendor User @relation("VendorSupportTickets", fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
  @@index([vendorId, status])
}

// Mirrors VendorSupportTicket — customers previously had no support
// channel at all (vendor and rider both did). Same shape, same status
// enum, so admin tooling can treat all three ticket types uniformly.
model CustomerSupportTicket {
  id          String              @id @default(uuid())
  customerId  String
  category    String
  subject     String
  description String
  status      SupportTicketStatus @default(OPEN)
  orderId     String? // optional — lets a ticket reference the order it's about
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  customer User @relation("CustomerSupportTickets", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([customerId, status])
}
