generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  username        String?   @unique
  name            String
  email           String    @unique
  phoneNumber     String?
  // Phase 1D.1: canonical phone identity used for uniqueness. phoneNumber
  // stays as the display/input-compatible field; phoneNumberE164 is the
  // normalized E.164 value (e.g. +2348012345678). OTP storage lives in
  // Redis, never in PostgreSQL.
  phoneNumberE164 String?   @unique
  isPhoneVerified Boolean   @default(false)
  phoneVerifiedAt DateTime?
  password        String?
  avatarUrl       String?
  preferences     String[]
  bio             String?
  role            Role?
  roles           Role[]    @default([])
  brandName       String?
  brandLogo       String?
  googleId        String?   @unique

  // KYC (NIN verification via Dojah) — required for VENDOR and DELIVERY
  // before they can go live. See src/services/dojah.service.ts.
  kycStatus KycStatus @default(PENDING)
  nin       String?   @unique
  ninData   Json? // raw Dojah verification response, stored for audit/dispute purposes

  // Vendor self-service settings persisted as JSON so the API can evolve without another table.
  deliveryPreferences Json?
  serviceAreas        Json?

  // ── Vendor Live ──────────────────────────────────────────────
  // VENDOR only: whether this vendor is active on the marketplace.
  // A product is orderable only while its vendor is live AND accepting
  // orders AND the product itself is not archived. Customers cannot toggle
  // this; vendors flip it via PATCH /api/vendor/settings/live (KYC VERIFIED
  // required to go live). Default false for new vendors.
  isLive Boolean @default(false)

  // ── Vendor payout fields ──────────────────────────────────────
  // Didn't exist at all before — there was no way for a vendor to ever
  // receive a payout through the platform. commissionRate is per-vendor
  // so it can be negotiated individually rather than being a single
  // global constant.
  commissionRate         Float                   @default(0.15)
  bankName               String?
  bankCode               String? // Paystack bank code, required for transfers (distinct from the display name)
  bankAccountNumber      String?
  bankAccountName        String? // set from Paystack's own resolution, not typed in by the vendor
  paystackRecipientCode  String? // set once bank details are verified with Paystack; cleared whenever bank details change
  vendorPayouts          VendorPayout[]          @relation("VendorPayouts")
  payoutsProcessed       VendorPayout[]          @relation("PayoutProcessedBy")
  vendorPromotions       Promotion[]             @relation("VendorPromotions")
  promotionUsages        PromotionUsage[]        @relation("UserPromotionUsages")
  vendorSupportTickets   VendorSupportTicket[]   @relation("VendorSupportTickets")
  customerSupportTickets CustomerSupportTicket[] @relation("CustomerSupportTickets")

  // ── Referrals ──────────────────────────────────────────────────
  // Didn't exist at all before. Every user gets their own shareable
  // code (generated on first request rather than at signup, so
  // existing accounts get one lazily too); referredByUserId records
  // who they signed up through, if anyone.
  referralCode            String?          @unique
  referredByUserId        String?
  referredBy              User?            @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referredUsers           User[]           @relation("UserReferrals")
  referralRewardsEarned   ReferralReward[] @relation("ReferralAsReferrer")
  referralRewardAsInvitee ReferralReward[] @relation("ReferralAsReferred")

  // ── Pot Points (Bottom Pot loyalty) ──────────────────────────────
  // Denormalized spendable balance; the PotPointTransaction ledger is the
  // source of truth and the only writer of this column (server-side, on
  // order COMPLETED). Clients can only read — never set — points.
  potPointsBalance Int @default(0)

  // Relations
  potPointTransactions      PotPointTransaction[] @relation("UserPotPointTransactions")
  products                  Product[]             @relation("VendorProducts")
  vendorReviewsReceived     VendorReview[]        @relation("VendorReviews")
  vendorReviewsGiven        VendorReview[]        @relation("CustomerVendorReviews")
  productReviewsGiven       ProductReview[]       @relation("CustomerProductReviews")
  customerOrders            Order[]               @relation("CustomerOrders")
  vendorOrders              Order[]               @relation("VendorOrders")
  vendorRepliesSent         VendorReply[]         @relation("VendorReplies")
  reviewVotes               ReviewVote[]          @relation("UserReviewVotes")
  reviewReports             ReviewReport[]        @relation("UserReviewReports")
  notifications             Notification[]        @relation("UserNotifications")
  loginHistory              LoginHistory[]        @relation("UserLoginHistory")
  addresses                 Address[]             @relation("UserAddresses")
  carts                     Cart[]                @relation("UserCarts")
  cartSummarySnapshots      CartSummarySnapshot[] @relation("UserCartSnapshots")
  UserPaymentMethod         UserPaymentMethod[]
  deliveryPerson            DeliveryPerson?
  riderWithdrawalsProcessed RiderWithdrawal[]     @relation("RiderWithdrawalProcessedBy")
  deliveryProofsReviewed    DeliveryProof[]       @relation("DeliveryProofReviewedBy")

  tokenVersion               Int                 @default(0)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  authProviders              String[]
  lastLoginAt                DateTime?
  loginMethod                String?
  isEmailVerified            Boolean             @default(false)
  // Admin moderation — didn't exist at all before; no way to suspend an
  // account for fraud/abuse without deleting it outright.
  isBlocked                  Boolean             @default(false)
  blockedReason              String?
  blockedAt                  DateTime?
  // Phase 1C vendor onboarding lifecycle. Null for non-vendors.
  // NEW = holds VENDOR but requirements unmet; ACTIVE = may go live;
  // PENDING_REVIEW = requirements met, manual approval needed (only when
  // VENDOR_AUTO_APPROVE=false); SUSPENDED = admin-set, cannot sell.
  vendorStatus               VendorStatus?
  vendorStatusReason         String?
  vendorStatusChangedAt      DateTime?
  emailVerificationToken     String?
  emailVerificationExpiresAt DateTime?
  passwordResetToken         PasswordResetToken? @relation("UserPasswordResetToken")
  payments                   Payment[]           @relation("UserPayments")
  RefundRequest              RefundRequest[]

  // ✅ Fixed Activity relations
  vendorActivities   Activity[] @relation("ActivityVendor")
  customerActivities Activity[] @relation("ActivityCustomer")

  // ✅ Vendor followers
  followers VendorFollower[] @relation("VendorFollowers") // people following this vendor
  following VendorFollower[] @relation("CustomerFollowing") // vendors this customer follows

  // Special Requests made by this user (as a customer)
  specialRequestsMade SpecialOrderRequest[] @relation("CustomerSpecialRequests")

  // Special Requests received by this user (as a vendor)
  specialRequestsReceived SpecialOrderRequest[] @relation("VendorSpecialRequests")

  // Special Offers sent by this vendor
  specialOffersSent SpecialOrderOffer[] @relation("VendorSpecialOffers")

  // Phase 2A catalog suggestions made by this user (as a vendor)
  categorySuggestionsMade CategorySuggestion[] @relation("SuggestionVendor")

  // Catalog suggestions reviewed by this user (as an admin)
  categorySuggestionsReviewed CategorySuggestion[] @relation("SuggestionReviewer")

  // Persistent refresh sessions — DB is source of truth, Redis is cache
  sessions UserSession[]
}

model UserSession {
  id              String   @id @default(uuid())
  userId          String
  sessionId       String   @unique
  /// Phase 1E: the role this SESSION is acting as, independent of every other
  /// session the same account holds and of the account-wide `User.role`.
  /// Nullable on purpose: rows that predate this column keep NULL and are
  /// treated as "whatever the account role was", so the migration is additive
  /// and needs no backfill and no forced re-login.
  activeRole      Role?
  ip              String?
  userAgent       String?
  deviceId        String?
  geoCity         String?
  geoRegion       String?
  geoCountry      String?
  createdAt       DateTime @default(now())
  lastRefreshedAt DateTime @updatedAt
  expiresAt       DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([userId, sessionId])
}

// 

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  street    String
  city      String
  state     String?
  country   String
  zipCode   String?
  landmark  String? // e.g. "Near Zenith Bank"
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([latitude, longitude])
  @@index([isDefault])
}

// Curated Bottom Pot food vocabulary ("What's in the Pot?").
// Phase 2A catalog taxonomy. Categories are admin/developer controlled
// (stable string ids); vendors never create them, they only suggest new
// DishTypes via CategorySuggestion.
model Category {
  id        String   @id // stable key, e.g. "RICE_DISHES"
  name      String   @unique // display name, e.g. "Rice Dishes"
  slug      String   @unique // URL-safe key, e.g. "rice-dishes"
  icon      String?
  sortOrder Int      @default(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dishTypes   DishType[]
  suggestions CategorySuggestion[]
  products    Product[]

  @@index([isActive, sortOrder])
}

// Vendors choose from active rows — they never free-type dish types, so
// "Ofada" / "ofada" / "OFADA" cannot duplicate. New dishes are added as
// rows (no deployment). Stable string ids (e.g. "JOLLOF") keep API
// contracts and Flutter code readable; OTHER is the honest fallback.
model DishType {
  id          String   @id // stable key, e.g. "JOLLOF", "OFADA", "OTHER"
  name        String   @unique // display name, e.g. "Jollof Rice"
  description String?
  imageUrl    String?
  sortOrder   Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Phase 2A: every dish belongs to exactly one Category.
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  products Product[]

  // Back-reference for suggestions approved into this canonical row.
  approvedSuggestion CategorySuggestion?

  @@index([isActive, sortOrder])
  @@index([categoryId])
  @@index([categoryId, isActive, sortOrder])
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String
  // Phase 3.2a drift remediation: search infrastructure owned by migration
  // 20261006000000_search (raw SQL). Declared here so the migrator sees the
  // live objects as expected state instead of drift. tsvector_col is
  // server-maintained by a trigger and is not application-written.
  tsvector_col Unsupported("tsvector")?
  price       Float
  archived    Boolean @default(false) // just like a delete function

  // What the food actually is (required, vendor-selected from DishType).
  dishTypeId String
  dishType   DishType @relation(fields: [dishTypeId], references: [id])

  // Phase 2B: denormalized shortcut for fast category filtering. The
  // authoritative classification stays dishTypeId -> DishType.categoryId;
  // this column is server-derived on write, never client-controlled.
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Portion size: how much food ONE purchased unit represents
  // (e.g. "1 portion", "Family Pack — serves 4–5"). Free text, not inventory.
  portionLabel String?

  // Phase 2B: same-day ordering window. Simple flag only — no scheduler,
  // no auto-activation; enforcement belongs to a later step.
  isScheduled Boolean @default(false)

  // Phase 2B: recurring same-day order deadline ("HH:MM", Africa/Lagos
  // business day). Null = no cutoff. Format validated at the API layer.
  orderCutoffTime String?

  // Phase 2B: maximum qualifying orders per business day. Null =
  // unlimited. Never 0-as-unlimited. Reservation logic belongs to a
  // later step; there is deliberately no Product-level counter column
  // (see ProductDailyCounter).
  dailyCap Int?

  // Inventory: remaining purchasable units. When trackInventory is false
  // the product has unlimited availability (stock is ignored). When true,
  // stock is authoritative and 0 means SOLD OUT (not orderable).
  trackInventory Boolean @default(false)
  stock          Int?

  images              String[]
  thumbnail           String? // 👈 ADD THIS
  video               String[]
  vendorId            String
  vendor              User                  @relation(name: "VendorProducts", fields: [vendorId], references: [id], onDelete: Cascade)
  reviews             ProductReview[]       @relation("ProductReviews")
  orders              Order[]               @relation("ProductOrders")
  orderItems          OrderItem[]
  options             ProductOption[]       @relation("ProductOptions")
  tags                ProductTag[]
  optionGroups        OptionGroup[]
  dailyCounters       ProductDailyCounter[]
  averageRating       Float?                @default(0)
  reviewCount         Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  CartItem            CartItem[]
  totalViews          Int                   @default(0) // all-time total views
  popularityScore     Float                 @default(0)
  popularityUpdatedAt DateTime? // <-- add this line
  popularityPercent   Float                 @default(0) // ✅ new field
  isNew               Boolean               @default(false) // ✅ Make sure this is here
  // Special requests associated with this product
  specialRequests     SpecialOrderRequest[] @relation("ProductSpecialRequests")
  promotions          Promotion[]           @relation("PromotionProducts")

  // Essential indexes (keep these)
  @@index([name], map: "product_name_idx") // Speeds up search suggestions
  @@index([dishTypeId]) // Dish-type filtering ("What's in the Pot?")
  @@index([vendorId], map: "product_vendor_idx") // Helps with vendor-specific queries
  @@index([vendorId, archived]) // Vendor storefront listing
  @@index([archived])
  @@index([createdAt])
  @@index([price])
  @@index([categoryId]) // Phase 2B category filtering
  @@index([categoryId, archived]) // Phase 2B category browse
  @@index([tsvector_col], map: "product_tsv_idx", type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "product_name_trgm_idx", type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], map: "product_description_trgm_idx", type: Gin)
}

model ProductOption {
  id              String            @id @default(uuid())
  productId       String
  name            String
  price           Float
  // Vendors can disable (not delete) an add-on; disabled add-ons are
  // rejected at cart/checkout time but preserved on historical orders
  // via the OrderItemOption snapshot.
  isActive        Boolean           @default(true)
  product         Product           @relation("ProductOptions", fields: [productId], references: [id], onDelete: Cascade)
  OrderItemOption OrderItemOption[]
  CartItemOption  CartItemOption[]

  @@unique([productId, name])
}

// Phase 2B structured add-ons. Coexists with (never replaces) the legacy
// flat ProductOption table: historical carts/orders keep their FKs, and
// the ProductOption → OptionGroup data migration belongs to Phase 2B.2.
model OptionGroup {
  id            String   @id @default(uuid())
  productId     String
  name          String
  required      Boolean  @default(false)
  minSelections Int      @default(0)
  maxSelections Int      @default(1)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   OptionGroupItem[]

  @@index([productId, sortOrder])
}

model OptionGroupItem {
  id            String   @id @default(uuid())
  optionGroupId String
  name          String
  // Same Float/naira representation as ProductOption.price. May be
  // negative (discount add-on). No kobo conversion in this phase.
  priceAdd      Float    @default(0)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  cartItemOptions CartItemOption[]
  orderItemOptions OrderItemOption[]

  @@index([optionGroupId, isActive, sortOrder])
}

// Phase 2B daily capacity counters: one row per product per Africa/Lagos
// business day. Separate table (not a Product column) so per-day rows
// expire naturally, refunds restore atomically, and concurrent checkouts
// serialize on the row. Increment/decrement logic belongs to a later step.
model ProductDailyCounter {
  productId String
  date      DateTime
  count     Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, date])
  @@index([date])
}

// Phase 2A product tagging. Canonical tags only (stable string ids);
// vendors attach/detach them, they never free-type tag names.
enum TagType {
  CUISINE
  DIET
  OCCASION
}

model Tag {
  id        String   @id // stable key, e.g. "SPICY" — never a random UUID
  name      String   @unique // display name, e.g. "Spicy"
  type      TagType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductTag[]

  @@index([type, isActive])
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([productId, tagId])
  @@index([tagId, productId])
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Phase 2A vendor dish suggestions. Vendors propose names against an
// existing Category; admins approve (creating the canonical DishType,
// linked via approvedDishTypeId) or reject with a note. No HTTP
// endpoints yet — schema only.
model CategorySuggestion {
  id String @id @default(uuid())

  vendorId String
  vendor   User   @relation("SuggestionVendor", fields: [vendorId], references: [id], onDelete: Cascade)

  suggestedName String

  suggestedCategoryId String
  suggestedCategory   Category @relation(fields: [suggestedCategoryId], references: [id], onDelete: Restrict)

  status SuggestionStatus @default(PENDING)

  adminNote String?

  reviewedByAdminId String?
  reviewedByAdmin   User?   @relation("SuggestionReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  reviewedAt DateTime?

  approvedDishTypeId String?   @unique
  approvedDishType   DishType? @relation(fields: [approvedDishTypeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([vendorId, status])
}

model Order {
  id               String      @id @default(uuid())
  customerId       String
  vendorId         String
  addressId        String?
  basePrice        Float
  extraCharge      Float       @default(0)
  // Delivery fee for this specific order, computed once per vendor at
  // checkout (see cartSummary.service.ts / deliveryFee.service.ts).
  // Previously there was no delivery fee concept anywhere — deliveries
  // were effectively always free and there was no out-of-range check.
  deliveryFee      Float       @default(0)
  totalPrice       Float
  // Phase 3.2a: per-order financial snapshots in kobo (integer minor units).
  // Nullable with no default and no backfill — historical rows predate the
  // writers (Phase 3.2b) and their exact values are unrecoverable, so NULL
  // here means "unknown history", never zero. Populated going-forward in
  // the same transaction that creates the Order.
  commissionKobo   BigInt?
  vendorPayoutKobo BigInt?
  discountKobo     BigInt?
  // Phase 3.2b: the exact vendor commission rate applied when this order's
  // commissionKobo was calculated. Nullable with no backfill — the rate is
  // read live at order creation and frozen here so later rate changes can
  // never rewrite history. Populated going-forward with the snapshots above.
  commissionRateSnapshot Float?
  vendorNote       String?
  customerApproval Boolean     @default(false)
  status           OrderStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt // ✅ add default

  // Set from the checkout request's Idempotency-Key header. A single
  // checkout can produce multiple orders (one per vendor in the cart),
  // all sharing the same key — so this is indexed, not unique, and a
  // retry with the same key returns the existing order(s) instead of
  // creating duplicates.
  idempotencyKey String?

  // Set once this order's revenue has been included in a VendorPayout —
  // prevents the same completed order from being paid out to the vendor
  // twice across multiple payout runs.
  payoutId String?
  // Restrict (NOT SetNull): deleting a payout must never silently reopen
  // its orders for a second payout. Payouts are never deleted via the API;
  // this guards out-of-band deletes against double-pay resurrection.
  payout   VendorPayout? @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  // Set when this order was created from an accepted special-order offer
  // rather than a normal cart checkout.
  specialOrderOfferId String?            @unique
  specialOrderOffer   SpecialOrderOffer? @relation("SpecialOfferOrder", fields: [specialOrderOfferId], references: [id])

  // Restrict (NOT Cascade): deleting a customer or vendor must never
  // erase their orders and the financial history (payments, refunds,
  // payouts, earnings) attached to them. Close/suspend via isBlocked /
  // vendorStatus instead; deactivation preserves history by design.
  customer    User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  vendor      User                 @relation("VendorOrders", fields: [vendorId], references: [id], onDelete: Restrict)
  address     Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    Payment[]            @relation("OrderPayments")
  refunds     RefundRequest[]
  Product     Product[]            @relation("ProductOrders")
  assignments DeliveryAssignment[]
  earnings    DeliveryEarning[]

  paymentInitiatedAt DateTime? // you already had this; kept for compatibility
  paymentStartedAt   DateTime? // optional clearer alias if you want to set it explicitly

  // paymentExpiresAt   DateTime? // Track payment expiration time
  paidAt        DateTime? // ✅ add this
  paymentStatus PaymentStatus? @default(PENDING)

  cancelledAt         DateTime?
  cancellationReason  String? // "PAYMENT_EXPIRED" | "USER_CANCELLED" | "VENDOR_REJECTED"
  protectedUntil      DateTime? // ← new field
  paymentGraceMinutes Int?                @default(15)
  Activity            Activity[]
  DeliveryBroadcast   DeliveryBroadcast[]
  // @@index([paymentExpiresAt])

  @@index([customerId, createdAt])
  @@index([vendorId, createdAt])
  @@index([status])
  @@index([idempotencyKey])
  @@index([payoutId])
}

model OrderItem {
  id        String            @id @default(uuid())
  orderId   String
  productId String
  // Phase 3.2a: catalog name snapshotted at checkout. Nullable with no
  // default and no backfill — the live Product relation remains the only
  // source for historical rows. Populated going-forward from the
  // revalidated product name in the checkout transaction.
  productName String?
  quantity  Int
  unitPrice Float
  subtotal  Float
  createdAt DateTime          @default(now())
  updatedAt DateTime? // specialRequest String? // NEW FIELD
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict (NOT Cascade): deleting a product must never silently delete
  // the OrderItem rows referencing it from customers' past orders. Removal
  // from sale is via archived=true; both delete paths refuse products
  // with order history (409) before the database constraint is reached.
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  options   OrderItemOption[]
}

model OrderItemOption {
  id            String        @id @default(uuid())
  // Phase 2B.5a dual option-source representation. Legacy rows carry
  // optionId; new rows carry optionGroupItemId instead. Exactly one must
  // be set — enforced by a database CHECK constraint (see migration), not
  // just application validation.
  optionId      String?
  name          String
  price         Float
  orderItemId   String
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  // Restrict (NOT Cascade): legacy option rows are frozen but still
  // referenced by historical orders. Matches the new optionGroupItem
  // convention directly below — deleting catalog must never delete history.
  productOption ProductOption? @relation(fields: [optionId], references: [id], onDelete: Restrict)
  optionGroupItemId String?
  // Restrict (NOT Cascade): deleting a catalog item must never silently
  // delete historical order records. Deactivate via isActive instead.
  optionGroupItem OptionGroupItem? @relation(fields: [optionGroupItemId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([optionId])
  @@index([optionGroupItemId])
}

model ProductReview {
  id               String   @id @default(uuid())
  productId        String
  customerId       String
  rating           Int
  comment          String?
  images           String[]
  createdAt        DateTime @default(now())
  verifiedPurchase Boolean  @default(false)

  product  Product        @relation("ProductReviews", fields: [productId], references: [id], onDelete: Cascade)
  customer User           @relation("CustomerProductReviews", fields: [customerId], references: [id], onDelete: Cascade)
  reply    VendorReply?
  votes    ReviewVote[]
  reports  ReviewReport[]

  @@index([productId, createdAt])
  @@index([customerId])
}

model VendorReply {
  id        String   @id @default(uuid())
  reviewId  String   @unique
  vendorId  String
  message   String
  createdAt DateTime @default(now())

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  vendor User          @relation("VendorReplies", fields: [vendorId], references: [id], onDelete: Cascade)
}

model ReviewVote {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  isHelpful Boolean
  createdAt DateTime @default(now())

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User          @relation("UserReviewVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

enum ReviewReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model ReviewReport {
  id                String             @id @default(uuid())
  reviewId          String
  userId            String
  reason            String
  status            ReviewReportStatus @default(PENDING)
  resolvedByAdminId String?
  resolvedAt        DateTime?
  createdAt         DateTime           @default(now())

