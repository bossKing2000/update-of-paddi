model DeliveryEarning {
  id               String   @id @default(uuid())
  deliveryPersonId String
  orderId          String
  baseFee          Float
  distanceFee      Float
  tip              Float    @default(0)
  deductions       Float    @default(0)
  totalEarned      Float
  createdAt        DateTime @default(now())

  deliveryPerson DeliveryPerson @relation(fields: [deliveryPersonId], references: [id])
  order          Order          @relation(fields: [orderId], references: [id])

  // F9: a completed delivery pays out exactly once. `orderId` is the key —
  // NOT (deliveryPersonId, orderId), which would still let two different riders
  // hold an earning against the same order and duplicate the rider payout.
  //
  // Domain: an order has a single `deliveryFee`, and the sole production writer
  // derives `totalEarned` from it, so one delivery can only ever produce one
  // earning. Reassignment writes DECLINED assignments, which can never reach
  // DELIVERED, so they never earn. `tip`/`deductions` are columns for future
  // use and have no writer today. With no supported multi-leg or multi-earning
  // model, "zero or one earning per order" is the real invariant.
  //
  // The primary application guard is the N-05A completion flow (the conditional
  // Order CAS plus the `orderTransitioned` earnings gate); this constraint is
  // the database-level financial backstop underneath it.
  @@unique([orderId])
}

