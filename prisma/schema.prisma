// A settlement run for one vendor over a period — the actual mechanism by
// which money moves from the platform to a vendor's bank account.
// Previously there was no such model at all; "payout" was just numbers
// computed on the fly with no record of what had actually been paid.
// A discount code. vendorId set = scoped to that one vendor's items only
// (and only counts against that vendor's subtotal/delivery fee in a
// multi-vendor cart); vendorId null = platform-wide, applies across the
// whole cart. Deliberately simpler than product/category-level targeting
// — a vendor-or-platform-wide code covers the common "10% off" /
// "free delivery" cases without the added complexity of per-product
// promo rules, which can be added later if there's real demand for it.
model Promotion {
  id       String  @id @default(uuid())
  // Null code = automatic product/vendor discount (no code entry required).
  // Non-null code = code-gated campaign redeemed via applyPromoService.
  // Previously every promotion required a code, which conflated ordinary
  // vendor product discounts with promo-code campaigns.
  code     String?
  vendorId String?
  vendor   User?   @relation("VendorPromotions", fields: [vendorId], references: [id], onDelete: Cascade)

  name        String
  description String?

  type        DiscountType
  value       Float // percentage (0-100) or fixed naira amount, depending on type
  maxDiscount Float? // caps a PERCENTAGE discount's naira value

  // Promotion scope: SINGLE_PRODUCT, SELECTED_PRODUCTS, VENDOR_WIDE
  // - SINGLE_PRODUCT: applies to exactly one product (productId required)
  // - SELECTED_PRODUCTS: applies to multiple specific products (products relation)
  // - VENDOR_WIDE: applies to all eligible products of the vendor (vendorId required)
  scope PromotionScope @default(VENDOR_WIDE)

  isActive Boolean @default(true)

  startsAt  DateTime?
  expiresAt DateTime?

  usageLimit     Int? // total redemptions allowed, across all users
  usedCount      Int  @default(0)
  maxUsesPerUser Int  @default(1)

  minOrderAmount Float @default(0) // minimum subtotal (of the scoped vendor, or whole cart if platform-wide) to qualify

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages   PromotionUsage[]
  products Product[]        @relation("PromotionProducts")

  @@unique([vendorId, code])
  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
}

model PromotionUsage {
  id          String   @id @default(uuid())
  promotionId String
  userId      String
  orderIds    String[] // every order this redemption's discount was applied across (a multi-vendor checkout batch)
  promoCode   String
  discount    Float

  createdAt DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user      User      @relation("UserPromotionUsages", fields: [userId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([userId])
  @@index([userId, promotionId])
}

/// Bottom Pot loyalty ledger (Pot Points).
///
/// One row per earn/redeem/adjust event. Earns are idempotent per order
/// (@@unique([orderId]) — an order credits points exactly once, no matter
/// how many times completion is processed). The User.potPointsBalance
/// column mirrors SUM(points) for cheap reads; only this ledger's writer
/// may change it, and only server-side (order COMPLETED hook / admin
/// adjust). Clients never submit point values.
enum PotPointTransactionType {
  EARN
  REDEEM
  ADJUST
}

model PotPointTransaction {
  id        String                  @id @default(uuid())
  userId    String
  user      User                    @relation("UserPotPointTransactions", fields: [userId], references: [id], onDelete: Cascade)
  points    Int // signed: EARN positive, REDEEM negative, ADJUST either
  type      PotPointTransactionType
  reason    String // e.g. "Order completed", "Admin adjustment"
  orderId   String? // set for EARN rows; unique so double-completion is safe
  createdAt DateTime                @default(now())

  @@unique([orderId])
  @@index([userId, createdAt])
}

