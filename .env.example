# ── Database / Infra ────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=
REDIS_TLS=
OPENSEARCH_NODE=
CLOUDINARY_URL=

# ── Auth secrets ────────────────────────────────────────────────
JWT_SECRET=
JWT_RESET_SECRET=

# ── App ──────────────────────────────────────────────────────────
PORT=5000
SERVER_URL=
BASE_URL=
CLIENT_URL=
NODE_ENV=development
BCRYPT_SALT_ROUNDS=10

# ── Email ────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# ── Google Sign-In ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Paystack ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=

# ── Dojah (KYC/NIN verification) ─────────────────────────────────
# Required for VENDOR and DELIVERY onboarding (src/services/dojah.service.ts)
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# Leave blank to default to https://sandbox.dojah.io — set explicitly to go live
DOJAH_BASE_URL=

# ── AI features (search correction, recommendations) ─────────────
OPENAI_API_KEY=

# ── Delivery fee tuning (src/services/deliveryFee.service.ts) ────
# All optional — sensible defaults are baked in if unset.
DELIVERY_BASE_FEE=300
DELIVERY_PER_KM_RATE=100
FREE_DELIVERY_THRESHOLD=15000
MAX_DELIVERY_DISTANCE_KM=20

# ── Referrals ──────────────────────────────────────────────────
# Flat reward (naira) credited to a referrer when the person they
# referred completes their first order. Optional, defaults to 500.
REFERRAL_REWARD_AMOUNT=500
