# ── Database / Infra ────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=
REDIS_TLS=
OPENSEARCH_NODE=
CLOUDINARY_URL=

# ── Auth secrets ────────────────────────────────────────────────
JWT_SECRET=
JWT_RESET_SECRET=
# AES-256-CBC key for stored bank account numbers (src/utils/encrypt.ts,
# required by src/config/config.ts). Must be exactly 32 characters or the
# application refuses to boot. Generate with:
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=
# HMAC secret for phone OTP digests (src/services/phoneOtp.service.ts).
# Required in production; generate with: openssl rand -hex 32
PHONE_OTP_SECRET=
# SMS provider used to deliver phone OTPs (src/services/sms/smsProvider.ts).
# buildProvider accepts only `log`, `memory` or `failing`; in development the
# default (unset) is LogSmsProvider, which never sends real SMS. Production
# refuses to boot without SMS_PROVIDER set, and rejects `log`/`memory`/`failing`
# there — a real provider is required for live delivery. Optional locally.
# Example dev value (never a real provider credential): log
SMS_PROVIDER=

# ── Vendor onboarding ──────────────────────────────────────────────
# Whether a newly onboarded vendor is auto-approved to ACTIVE without admin
# review (src/services/vendorStatus.service.ts:isVendorAutoApprove).
# Optional — defaults to true when unset. Set "false" to require manual
# approval before a vendor can go live.
VENDOR_AUTO_APPROVE=true

# ── App ──────────────────────────────────────────────────────────
PORT=5000
SERVER_URL=
BASE_URL=
CLIENT_URL=
NODE_ENV=development
BCRYPT_SALT_ROUNDS=10

# ── Email ────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# ── Google Sign-In ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Paystack ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=

# ── Dojah (KYC/NIN verification) ─────────────────────────────────
# Required for VENDOR and DELIVERY onboarding (src/services/dojah.service.ts)
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# Leave blank to default to https://sandbox.dojah.io — set explicitly to go live
DOJAH_BASE_URL=

# ── AI features (search correction, recommendations) ─────────────
OPENAI_API_KEY=

# ── Delivery fee tuning (src/services/deliveryFee.service.ts) ────
# All optional — sensible defaults are baked in if unset.
# IMPORTANT: all delivery-fee amounts are INTEGER KOBO (minor currency unit),
# not naira. ₦300 = 30000 kobo. A value of "300" would mean ₦3, not ₦300.
DELIVERY_BASE_FEE=30000
DELIVERY_PER_KM_RATE=10000
FREE_DELIVERY_THRESHOLD=1500000
MAX_DELIVERY_DISTANCE_KM=20

# ── Referrals ──────────────────────────────────────────────────
# Flat reward credited to a referrer when the person they referred
# completes their first order. Optional, defaults to 500.
# IMPORTANT: `referralReward.amount` is stored as INTEGER KOBO (Phase 3A),
# so ₦500 = 50000 kobo. A value of "500" would mean ₦5, not ₦500.
REFERRAL_REWARD_AMOUNT=50000

# ── Stranded delivery dispatch observation (READ-ONLY) ───
# Logs how many orders look stranded in dispatch. Writes nothing: no
# assignment, no broadcast change, no notification.
#
# DISABLED BY DEFAULT. Must be exactly "true" to register the cron job.
# Leave unset in local, CI, staging and any environment that runs seeders —
# the scan reads real tables and would report fixture orders as stranded.
RECONCILE_STRANDED_DISPATCH_ENABLED=false

# Required when enabled; the job refuses to run without them. No defaults are
# baked in because the safe values depend on your online-driver population and
# database budget, which the code cannot see.
#
# RECONCILE_STRANDED_DISPATCH_PAGE_SIZE:   candidates read per query.
# RECONCILE_STRANDED_DISPATCH_GRACE_MINUTES: age a dispatch artifact must exceed.
# RECONCILE_STRANDED_DISPATCH_MAX_PAGES:  pages per invocation.
#
# Higher values improve coverage and lengthen the run; they cannot both be
# maximised. Every page restarts from the beginning, so a truncated run may
# miss candidates indefinitely and reports `truncated: true` when that happens.
RECONCILE_STRANDED_DISPATCH_PAGE_SIZE=
RECONCILE_STRANDED_DISPATCH_GRACE_MINUTES=
RECONCILE_STRANDED_DISPATCH_MAX_PAGES=
